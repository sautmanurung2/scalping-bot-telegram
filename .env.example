# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# AI Provider Configuration (OpenAI / Gemini / Claude / Ollama)
AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=YOUR_AI_PROVIDER_API_KEY_HERE
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30s

# Secondary AI Provider Configuration (Circuit Breaker / Fallback)
SECONDARY_AI_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
SECONDARY_AI_API_KEY=YOUR_SECONDARY_AI_API_KEY_HERE
SECONDARY_AI_MODEL=gemini-1.5-flash

# Database Path Configuration
DB_PATH=trading_bot.db
